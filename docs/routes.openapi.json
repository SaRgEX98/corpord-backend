    "/catalog/{kind}": {
      "get": {
        "description": "Bounded ID-ordered keyset page. Trips are summaries; stops are loaded from detail. No per-row queries. Legacy arrays are capped at 100.",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "cities",
                "regions",
                "stops",
                "buses",
                "drivers",
                "trips",
                "tripStops",
                "busCategories",
                "busStatuses",
                "driverStatuses"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "city_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or cursor scope"
          },
          "503": {
            "description": "Search timeout"
          }
        }
      }
    },
    "/admin/catalog/{kind}": {
      "get": {
        "description": "Admin-only catalog. The users kind never returns password hashes or identities.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "users"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "city_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Admin role required"
          }
        }
      }
    },
    "/admin/catalog-counts": {
      "get": {
        "description": "Admin-only, approximate planner row estimates. No full collection scans.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Map of catalog kind to {value,approximate:true}; value nullable before ANALYZE"
          },
          "403": {
            "description": "Admin role required"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "city",
              "stop"
            ]
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "nullable": true
          },
          "served": {
            "type": "boolean"
          },
          "rank_reason": {
            "type": "string",
            "enum": [
              "match",
              "connected",
              "popular"
            ]
          },
          "address": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "nullable": true
          },
          "city_name": {
            "type": "string",
            "description": "Parent settlement name for disambiguating stops."
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "region",
          "timezone",
          "served",
          "rank_reason",
          "address",
          "latitude",
          "longitude"
        ]
      },
      "City": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "region": {
            "type": "string",
            "maxLength": 160
          },
          "timezone": {
            "type": "string"
          },
          "popularity": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "region",
          "timezone",
          "popularity"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "rule_version": {
            "type": "string",
            "enum": [
              "segment-v1"
            ]
          },
          "calculated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "amount_minor",
          "currency",
          "rule_version",
          "calculated_at"
        ]
      },
      "Availability": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unknown"
            ]
          },
          "seats": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "required": [
          "status",
          "seats"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "boarding_stop_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "alighting_stop_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "passengers": {
            "type": "integer",
            "enum": [
              1
            ],
            "default": 1
          }
        },
        "required": [
          "boarding_stop_id",
          "alighting_stop_id"
        ]
      },
      "Place": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "kind",
          "city",
          "region",
          "country",
          "latitude",
          "longitude"
        ]
      },
      "Segment": {
        "type": "object",
        "properties": {
          "trip_id": {
            "type": "integer",
            "format": "int64"
          },
          "boarding_stop_id": {
            "type": "integer",
            "format": "int64"
          },
          "alighting_stop_id": {
            "type": "integer",
            "format": "int64"
          },
          "boarding_name": {
            "type": "string"
          },
          "alighting_name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "arrival_timezone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "departure_time": {
            "type": "string",
            "format": "date-time"
          },
          "arrival_time": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ],
            "nullable": true
          },
          "availability": {
            "$ref": "#/components/schemas/Availability"
          },
          "is_demo": {
            "type": "boolean",
            "description": "Fictional timetable and test fares; no real transport service is asserted."
          }
        },
        "required": [
          "trip_id",
          "boarding_stop_id",
          "alighting_stop_id",
          "boarding_name",
          "alighting_name",
          "timezone",
          "arrival_timezone",
          "status",
          "departure_time",
          "arrival_time",
          "price",
          "availability"
        ]
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "Quote": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Segment"
          },
          {
            "type": "object",
            "properties": {
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "reserves_seat": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
              "expires_at",
              "reserves_seat"
            ]
          }
        ]
      },
      "Calendar": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "calculated_at": {
            "type": "string",
            "format": "date-time"
          },
          "rule_version": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "no_trips"
                  ]
                },
                "min_price_minor": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0,
                  "nullable": true
                },
                "trip_count": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                }
              },
              "required": [
                "date",
                "status",
                "min_price_minor",
                "trip_count"
              ]
            }
          },
          "contains_demo": {
            "type": "boolean"
          }
        },
        "required": [
          "timezone",
          "month",
          "calculated_at",
          "rule_version",
          "days"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
