# Application
APP_ENV=development
APP_NAME=corpord-api
APP_DEBUG=true
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=postgres
DB_POSTGRES_NAME=corpord
DB_POSTGRES_SSLMODE=disable
DB_POSTGRES_MAX_CONNS=10
DB_REDIS_HOST=localhost
DB_REDIS_PORT=6379
DB_REDIS_PASSWORD=
DB_REDIS_DB=0

# HTTP Server
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# JWT: replace with an independent random secret, for example openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SIGNING_ALGORITHM=HS256

# Cookies: empty domain creates a cookie scoped to the API host.
COOKIE_DOMAIN=
# Empty uses true in production and false in development.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Enable only after supplying all three provider values.
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
SSO_YANDEX_ENABLED=false
SSO_YANDEX_CLIENT_ID=
SSO_YANDEX_CLIENT_SECRET=
SSO_YANDEX_REDIRECT_URL=http://localhost:8080/api/v1/auth/yandex/callback
